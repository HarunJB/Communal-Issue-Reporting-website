<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sarajevo Reports</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="navbar navbar-expand">
            <div class="container">
                <a class="navbar-brand" asp-controller="Account" asp-action="Login">
                    <span class="brand-mark" aria-hidden="true"></span>Sarajevo Reports
                </a>
                <div class="ms-auto d-flex align-items-center gap-3">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span class="nav-user d-none d-sm-inline">@User.Identity.Name</span>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                            <button type="submit" class="btn btn-outline-light btn-sm">Log out</button>
                        </form>
                    }
                    else
                    {
                        <a class="nav-link-light" asp-controller="Account" asp-action="Login">Login</a>
                        <a class="btn btn-accent btn-sm" asp-controller="Account" asp-action="Register">Register</a>
                    }
                </div>
            </div>
        </nav>
    </header>

    <main class="container py-4 py-md-5">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">Senior design project &middot; Sarajevo communal issue reporting</div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
