@model UserFormModel
@{
    var creating = Model.Id == 0;
    ViewData["Title"] = creating ? "Add staff account" : "Edit user";
}

<div class="page-head">
    <div>
        <a class="form-hint text-decoration-none" asp-action="Users">&larr; Users</a>
        <h1 class="page-title">@ViewData["Title"]</h1>
    </div>
</div>

<section class="panel form-narrow">
    <form asp-action="@(creating ? "UserCreate" : "UserEdit")" method="post" novalidate>
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <div class="row g-3">
            <div class="col-sm-6">
                <label asp-for="FirstName" class="form-label">First name</label>
                <input asp-for="FirstName" class="form-control" />
                <span asp-validation-for="FirstName" class="field-error"></span>
            </div>
            <div class="col-sm-6">
                <label asp-for="LastName" class="form-label">Last name</label>
                <input asp-for="LastName" class="form-control" />
                <span asp-validation-for="LastName" class="field-error"></span>
            </div>
            <div class="col-12">
                <label asp-for="Email" class="form-label">Email</label>
                <input asp-for="Email" type="email" class="form-control" />
                <span asp-validation-for="Email" class="field-error"></span>
            </div>
            <div class="col-sm-6">
                <label asp-for="Role" class="form-label">Role</label>
                <select asp-for="Role" class="form-select" id="user-role" disabled="@Model.IsSelf">
                    <option value="operator">Operator</option>
                    <option value="admin">Admin</option>
                    @if (!creating) { <option value="citizen">Citizen</option> }
                </select>
                @if (Model.IsSelf)
                {
                    <input type="hidden" asp-for="Role" />
                    <div class="form-hint">You cannot change your own role.</div>
                }
                <span asp-validation-for="Role" class="field-error"></span>
            </div>
            <div class="col-sm-6" id="department-field">
                <label asp-for="DepartmentId" class="form-label">Department</label>
                <select asp-for="DepartmentId" class="form-select">
                    <option value="">None</option>
                    @foreach (var d in Model.Departments)
                    {
                        <option value="@d.Id" selected="@(Model.DepartmentId == d.Id)">@d.Name</option>
                    }
                </select>
                <div class="form-hint">Operators only see issues of this department.</div>
                <span asp-validation-for="DepartmentId" class="field-error"></span>
            </div>
            <div class="col-12">
                <label asp-for="Password" class="form-label">@(creating ? "Password" : "New password")</label>
                <input asp-for="Password" type="password" class="form-control" autocomplete="new-password" />
                <div class="form-hint">@(creating ? "At least 8 characters. Share it with the person safely and ask them to change it." : "Leave empty to keep the current password.")</div>
                <span asp-validation-for="Password" class="field-error"></span>
            </div>
        </div>
        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-navy">@(creating ? "Create account" : "Save changes")</button>
            <a class="btn btn-soft" asp-action="Users">Cancel</a>
        </div>
    </form>
</section>

@if (!creating && Model.Reputation is not null)
{
    var rep = Model.Reputation;
    <section class="panel form-narrow section-gap">
        <h2 class="panel-title">Trust score</h2>
        <p class="mb-2">
            <span class="chip @ReputationRules.ChipClass(rep.Score)">@rep.Score &middot; @rep.LevelLabel</span>
            <span class="form-hint">
                @rep.Confirmed confirmed reports, @rep.FalseReports rejected as not found &middot;
                today @rep.ReportsToday of @rep.DailyLimit reports allowed
            </span>
        </p>
        <div class="form-hint mb-3">
            Staff decisions on reports change the score automatically (+@ReputationRules.ConfirmedPoints when a report is accepted,
            &minus;@ReputationRules.FalsePenalty when rejected as &ldquo;not found&rdquo;). Use the form below only to correct a mistake or for special cases.
        </div>

        <form asp-action="AdjustScore" asp-route-id="@Model.Id" method="post" class="row g-2 align-items-end">
            <div class="col-sm-3">
                <label class="form-label" for="score-delta">Points</label>
                <input id="score-delta" name="delta" type="number" min="-100" max="100" step="1" class="form-control" placeholder="e.g. 15 or -10" required />
            </div>
            <div class="col-sm-6">
                <label class="form-label" for="score-note">Reason (the citizen sees it)</label>
                <input id="score-note" name="note" maxlength="300" class="form-control" required />
            </div>
            <div class="col-sm-3">
                <button type="submit" class="btn btn-navy w-100" data-confirm="Change this citizen's trust score?">Apply</button>
            </div>
        </form>

        @if (Model.ReputationEvents.Count > 0)
        {
            <div class="table-wrap mt-3">
                <table class="table-dash">
                    <thead><tr><th>When</th><th>What</th><th class="num">Points</th><th class="num">Score</th></tr></thead>
                    <tbody>
                    @foreach (var e in Model.ReputationEvents)
                    {
                        <tr>
                            <td>@UiFormat.DateTimeText(e.CreatedAt)</td>
                            <td>
                                @ReputationRules.KindLabel(e.Kind)
                                @if (e.ReportId.HasValue) { <span>&middot; <a asp-controller="Issues" asp-action="Details" asp-route-id="@e.ReportId">#@e.ReportId</a></span> }
                                @if (!string.IsNullOrWhiteSpace(e.Note)) { <div class="muted">@e.Note</div> }
                            </td>
                            <td class="num">@(e.Delta > 0 ? "+" + e.Delta : e.Delta.ToString())</td>
                            <td class="num">@e.ScoreAfter</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="form-hint mt-3">No changes yet: this citizen is still at the starting score.</div>
        }
    </section>
}

@section Scripts {
<script>
    (function () {
        var role = document.getElementById('user-role');
        var field = document.getElementById('department-field');
        if (!role || !field) return;
        function sync() {
            var isOperator = role.value === 'operator';
            field.style.display = isOperator ? '' : 'none';
            if (!isOperator) { var sel = field.querySelector('select'); if (sel) sel.value = ''; }
        }
        role.addEventListener('change', sync);
        sync();
    })();
</script>
}
