@model DepartmentFormModel
@{
    var creating = Model.Id == 0;
    ViewData["Title"] = creating ? "Add department" : "Edit department";
}

<div class="page-head">
    <div>
        <a class="form-hint text-decoration-none" asp-action="Departments">&larr; Departments</a>
        <h1 class="page-title">@ViewData["Title"]</h1>
    </div>
</div>

<section class="panel form-narrow">
    <form asp-action="DepartmentEdit" method="post" novalidate>
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <div class="row g-3">
            <div class="col-sm-6">
                <label asp-for="NameEn" class="form-label">Name (English)</label>
                <input asp-for="NameEn" class="form-control" />
                <span asp-validation-for="NameEn" class="field-error"></span>
            </div>
            <div class="col-sm-6">
                <label asp-for="NameBs" class="form-label">Name (Bosnian)</label>
                <input asp-for="NameBs" class="form-control" />
                <span asp-validation-for="NameBs" class="field-error"></span>
            </div>
            <div class="col-12">
                <label asp-for="ContactEmail" class="form-label">Contact email <span class="form-hint">(optional)</span></label>
                <input asp-for="ContactEmail" type="email" class="form-control" />
                <span asp-validation-for="ContactEmail" class="field-error"></span>
            </div>
            <div class="col-12">
                <div class="form-check">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label">Active</label>
                </div>
            </div>
        </div>
        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-navy">Save</button>
            <a class="btn btn-soft" asp-action="Departments">Cancel</a>
        </div>
    </form>
</section>
